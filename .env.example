# ==========================================
# LegalEase Environment Configuration
# ==========================================

# Gemini API key
# Get this from Google AI Studio.
GEMINI_API_KEY=
# Gemini model
GEMINI_MODEL=gemini-3.8-flash

# ==========================================
# Backend
# ==========================================

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ==========================================
# AI Mode
# ==========================================

# true  = local testing without Gemini
# false = use Gemini API
MOCK_AI=false

# ==========================================
# Application
# ==========================================

APP_NAME=LegalEase
COMPANY_NAME=LegalEase

# ==========================================
# Branding
# ==========================================

LOGO_PATH=assets/logo.png

# ==========================================
# Document Formatting
# ==========================================

DOCUMENT_FONT=Times New Roman

DOCUMENT_FOOTER=Generated with LegalEase - AI-assisted drafting - review before use